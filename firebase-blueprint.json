{
  "entities": {
    "AdminSecurity": {
      "title": "AdminSecurity",
      "description": "Synchronized hashed admin credentials and security configuration across all devices.",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 120,
          "description": "Administrator login email address."
        },
        "pinHash": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[a-f0-9]{64}$",
          "description": "Salted SHA-256 hex digest of the admin security PIN."
        },
        "passwordHash": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[a-f0-9]{64}$",
          "description": "Salted SHA-256 hex digest of the admin password."
        },
        "lastProofHash": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[a-f0-9]{64}$",
          "description": "Verification hash matching the prior PIN or password during rotation."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of the latest security update."
        }
      },
      "required": ["email", "pinHash", "passwordHash", "lastProofHash", "updatedAt"]
    },
    "CatalogProduct": {
      "title": "CatalogProduct",
      "description": "Scooty inventory item synchronized across devices.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "name": { "type": "string", "minLength": 1, "maxLength": 160 },
        "category": { "type": "string", "enum": ["Electric", "Petrol", "Sports", "Kids", "City"] },
        "brand": { "type": "string", "minLength": 1, "maxLength": 80 },
        "price": { "type": "number" },
        "availability": { "type": "string", "enum": ["In Stock", "Limited Stock", "Pre-Order", "Out of Stock"] },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "category", "brand", "price", "availability", "updatedAt"]
    },
    "SiteConfig": {
      "title": "SiteConfig",
      "description": "Global dealership settings, phone numbers, social links, and announcement bar.",
      "type": "object",
      "properties": {
        "phone": { "type": "string", "minLength": 3, "maxLength": 40 },
        "whatsappNumber": { "type": "string", "minLength": 3, "maxLength": 40 },
        "email": { "type": "string", "minLength": 3, "maxLength": 120 },
        "workingHours": { "type": "string", "maxLength": 200 },
        "heroBadge": { "type": "string", "maxLength": 160 },
        "heroTagline": { "type": "string", "maxLength": 400 },
        "deliveryNotice": { "type": "string", "maxLength": 400 },
        "footerText": { "type": "string", "maxLength": 500 },
        "paymentAccounts": { "type": "array" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["phone", "whatsappNumber", "email", "updatedAt"]
    },
    "CustomerOrder": {
      "title": "CustomerOrder",
      "description": "Customer booking record persisted across sessions and devices.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "customerId": { "type": "string", "maxLength": 120 },
        "accountType": { "type": "string", "enum": ["Registered", "Guest"] },
        "customerName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "customerPhone": { "type": "string", "minLength": 5, "maxLength": 40 },
        "alternatePhone": { "type": "string", "maxLength": 40 },
        "customerEmail": { "type": "string", "maxLength": 120 },
        "cnic": { "type": "string", "maxLength": 30 },
        "city": { "type": "string", "minLength": 1, "maxLength": 80 },
        "areaLandmark": { "type": "string", "maxLength": 160 },
        "shippingAddress": { "type": "string", "minLength": 1, "maxLength": 400 },
        "totalAmount": { "type": "number" },
        "paymentMethod": { "type": "string", "enum": ["Cash on Delivery", "Bank Transfer / Raast", "Online Card"] },
        "paymentDetail": { "type": "string", "maxLength": 240 },
        "notes": { "type": "string", "maxLength": 300 },
        "status": { "type": "string", "enum": ["Pending", "Confirmed", "Shipped", "Delivered", "Cancelled"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "customerName", "customerPhone", "city", "shippingAddress", "totalAmount", "paymentMethod", "status", "createdAt"]
    },
    "SiteBanner": {
      "title": "SiteBanner",
      "description": "Promotional hero banner synchronized across all devices.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "tag": { "type": "string", "minLength": 1, "maxLength": 80 },
        "title": { "type": "string", "minLength": 1, "maxLength": 160 },
        "subtitle": { "type": "string", "maxLength": 400 },
        "ctaText": { "type": "string", "maxLength": 80 },
        "ctaLink": { "type": "string", "maxLength": 200 },
        "bgGradient": { "type": "string", "maxLength": 160 },
        "active": { "type": "boolean" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "tag", "title", "active", "updatedAt"]
    },
    "PushSubscription": {
      "title": "PushSubscription",
      "description": "Permanent background Web Push and FCM device subscription persisted across sessions, logouts, and device restarts.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "deviceId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "endpoint": { "type": "string", "minLength": 10, "maxLength": 2000 },
        "p256dh": { "type": "string", "minLength": 10, "maxLength": 500 },
        "auth": { "type": "string", "minLength": 6, "maxLength": 200 },
        "fcmToken": { "type": "string", "maxLength": 500 },
        "customerId": { "type": "string", "maxLength": 128 },
        "customerName": { "type": "string", "maxLength": 120 },
        "customerPhone": { "type": "string", "maxLength": 40 },
        "platform": { "type": "string", "enum": ["Android", "iOS", "Desktop", "Mobile"] },
        "browserLabel": { "type": "string", "maxLength": 160 },
        "status": { "type": "string", "enum": ["active", "expired", "unsubscribed"] },
        "failureReason": { "type": "string", "maxLength": 300 },
        "createdAt": { "type": "string", "format": "date-time" },
        "lastVerifiedAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "deviceId", "endpoint", "p256dh", "auth", "platform", "browserLabel", "status", "createdAt", "lastVerifiedAt", "updatedAt"]
    },
    "PushNotificationRecord": {
      "title": "PushNotificationRecord",
      "description": "Permanent push notification broadcast history retained until explicitly deleted by users or admins.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "title": { "type": "string", "minLength": 1, "maxLength": 160 },
        "body": { "type": "string", "minLength": 1, "maxLength": 800 },
        "category": { "type": "string", "enum": ["offer", "order", "new_arrival", "announcement", "general"] },
        "url": { "type": "string", "minLength": 1, "maxLength": 300 },
        "imageUrl": { "type": "string", "maxLength": 2000 },
        "targetType": { "type": "string", "enum": ["all", "customer"] },
        "targetCustomerId": { "type": "string", "maxLength": 128 },
        "targetPhone": { "type": "string", "maxLength": 40 },
        "sentBy": { "type": "string", "enum": ["Admin", "System"] },
        "sentCount": { "type": "number" },
        "failedCount": { "type": "number" },
        "expiredCount": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "title", "body", "category", "url", "targetType", "sentBy", "sentCount", "failedCount", "expiredCount", "createdAt", "updatedAt"]
    },
    "DeviceNotificationState": {
      "title": "DeviceNotificationState",
      "description": "Per-device read and dismissed notification history state without touching push subscriptions.",
      "type": "object",
      "properties": {
        "deviceId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "readIds": { "type": "array" },
        "dismissedIds": { "type": "array" },
        "clearedBefore": { "type": "string", "maxLength": 60 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["deviceId", "readIds", "dismissedIds", "updatedAt"]
    }
  },
  "firestore": {
    "/app_config/{configId}": {
      "schema": { "$ref": "#/entities/AdminSecurity" },
      "description": "Stores synchronized admin security hashes (admin_security) and global dealership config."
    },
    "/site_settings/{settingId}": {
      "schema": { "$ref": "#/entities/SiteConfig" },
      "description": "Stores live phone numbers, WhatsApp, social links, and announcement text."
    },
    "/products/{productId}": {
      "schema": { "$ref": "#/entities/CatalogProduct" },
      "description": "Stores scooty catalog items."
    },
    "/banners/{bannerId}": {
      "schema": { "$ref": "#/entities/SiteBanner" },
      "description": "Stores promotional banners."
    },
    "/orders/{orderId}": {
      "schema": { "$ref": "#/entities/CustomerOrder" },
      "description": "Stores customer scooty orders."
    },
    "/push_subscriptions/{subscriptionId}": {
      "schema": { "$ref": "#/entities/PushSubscription" },
      "description": "Stores permanent user push subscriptions (endpoint, encryption keys, FCM token, status)."
    },
    "/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/PushNotificationRecord" },
      "description": "Stores permanent admin & order push notification history."
    },
    "/device_notification_state/{deviceId}": {
      "schema": { "$ref": "#/entities/DeviceNotificationState" },
      "description": "Stores per-device read and deleted notification history state independently from push subscriptions."
    }
  }
}
